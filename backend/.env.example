# === Núcleo ===
DATABASE_URL=postgresql://usuario:password@host:5432/crmht   # Railway lo inyecta automáticamente
JWT_SECRET=crmHT_secret_CAMBIAR
APP_URL=http://localhost:3001                                # En Railway: https://<tu-app>.up.railway.app
PORT=3001
ADMIN_PASSWORD=Admin2024!                                    # Contraseña inicial del admin (cámbiala al primer ingreso)
DESCUENTO_MAX_SIN_APROBACION=10
LEADS_WEB_API_KEY=                                           # Etapa 2 — compartida con backend de hidrotecnica.cl
COWORK_API_KEY=                                              # HT-DO-XX — Bearer token para la API /api/v1 (integración Cowork)

# === Microsoft Graph (Etapa 2 — correo dominio hidrotecnica.cl) ===
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_REDIRECT_URI=${APP_URL}/api/auth/graph/callback

# === WhatsApp Cloud API (Etapa 4) ===
# Nombres reales que lee el código (services/whatsapp.js, routes/public.js) —
# los anteriores (WA_...) habían quedado desactualizados, no los usa nada.
# Cuenta "Ventas" (la que ya está en producción):
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Cuenta "Oficial" (número oficial de la empresa, opcional — nota v1.30): con
# ambas variables definidas, el CRM la reconoce sola por su phone_number_id,
# sin necesidad de tocar código (ver config/whatsappCuentas.js).
WHATSAPP_PHONE_NUMBER_ID_OFICIAL=
WHATSAPP_ACCESS_TOKEN_OFICIAL=

# === IA (resumen diario y memoria de conversaciones de WhatsApp, services/whatsappMemoria.js) ===
ANTHROPIC_API_KEY=

# === Correos transaccionales del sistema (Brevo) ===
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HidroTecnica CRM <no-reply@hidrotecnica.cl>
